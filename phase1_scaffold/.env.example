# ═══════════════════════════════════════════════════════════
#  INDMoney Weekly Pulse Generator — Environment Variables
# ═══════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your actual values:
#    cp phase1_scaffold/.env.example .env
#
#  ⚠️  NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════

# ── Groq LLM ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Play Store Scraper ───────────────────────────────────
APP_ID=com.indmoney.indstocks
REVIEW_COUNT=1000
SCRAPER_LANG=en
SCRAPER_COUNTRY=in

# ── Data Ingestion ───────────────────────────────────────
WEEKS_BACK=8

# ── Gmail IMAP (Email Drafts) ────────────────────────
# Use your regular Gmail address
# Generate a 16-character App Password from Google Account Security
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# ── Google Docs Integration ──────────────────────────────
GOOGLE_DOC_ID=your_google_doc_id_here

# ── MCP Server ───────────────────────────────────────────
MCP_COMMAND=npx
MCP_ARGS=-y,@modelcontextprotocol/server-everything
